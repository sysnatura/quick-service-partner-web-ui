@*@model Sysnatura.WFMS.BOL.Setup.UserDto
    @{
        ViewBag.Title = "UserLogin";
        Layout = null;
    }*@
@*@Styles.Render("~/Content/css")*@


<link href="~/bower_components/angular-material/angular-material.css" rel="stylesheet" />
<link href="~/Content/styles/login.css" rel="stylesheet" />




<div id="login-v2" layout="row" layout-align="start" class="ng-scope layout-align-start-stretch layout-row">
    <div id="login-v2-form-wrapper" class="flex-scrollable" ms-scroll>
        <div id="login-v2-form" class="md-whiteframe-8dp">
            <div class="top-bg-11 md-accent-bg">
                <div class="logo">
                    <img src="../../assets/images/logos/logo-01.png">
                </div>
                <div class="md-accent-bg text-style-01">
                    <span>HOME MAINTAINANCE<br>
                    SERVICE AUTOMATION SYSTEM</span>
                </div>
            </div>
            <div class="title" translate="LOGIN_V2.TITLE">Log in to Service Company Account</div>
            <div class="description" translate="LOGIN_V2.DESCRIPTION">Enter user name & password to login</div>
            <div class="mb-10">
                @if (TempData["LoginMessage"] != null)
                {
                    <span class="text-danger"> @TempData["LoginMessage"].ToString()</span>
                }
            </div>

            <form class="form-horizontal" action="@Url.Action("Login", "Account")" method="POST">

                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", @placeholder = "User Name", @required = "true" })
                <div ng-messages="loginForm.email.$error" role="alert" multiple>

                </div>

                @Html.TextBoxFor(m => m.Password, new { @type = "password", @placeholder = "Password", @class = "form-control", @required = "true" })
                <div ng-messages="loginForm.password.$error" role="alert">

                </div>


                @if (ViewData["error"] != null)
                {
                    <span class="text-danger"> @ViewData["error"].ToString()</span>
                }
                <div class="btn-group">
                    <button id="btnSignIn" type="submit" class="btn btn-blue-01 login-btn">Sign In</button>
                </div>
                @* Commented by Jithin S on 12/10/2022 for disable timezon validation for login  *@
                @*<script type="text/javascript">
                    var dt = new Date();
                    var os = dt.getTimezoneOffset();
                    if (os != -240) {
                        document.getElementById('btnSignIn').disabled = true;
                        document.write('<br/><br/><span class="text-danger">Please set the computer system time zone to<br/>(UTC +4:00) Abu Dhabi, Muscat and reload the page.</span>');
                    }
                </script>*@
            </form>
            <div layout="column" layout-align="start center">
            </div>
        </div>
    </div>
</div>

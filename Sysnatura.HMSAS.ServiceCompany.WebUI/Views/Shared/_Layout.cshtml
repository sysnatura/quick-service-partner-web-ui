<!doctype html>
<html ng-app="fuse">
<head>
    <link rel="shortcut icon" type="image/png" href="/favicon.png" />
    <meta charset="utf-8">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>Partners - Aspirom Quick Service</title>
    
    @Styles.Render("~/Styles/css")
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,300,400italic,500,700" rel="stylesheet" type="text/css">    
</head>
<!--[if lt IE 10]>
    <p class="browsehappy">
        You are using an <strong>outdated</strong> browser. Please <a href="http://browsehappy.com/">
            upgrade
            your browser
        </a> to improve your experience.
    </p>
<![endif]-->

<body block-ui="main_ui" md-theme="{{vm.themes.active.name}}" md-theme-watch ng-controller="IndexController as vm"
      class="{{state.current.bodyClass || ''}}">
<!-- SPLASH SCREEN -->
<ms-splash-screen id="splash-screen">
    <div class="center">
        <div class="logo">
            <span><img src="../../assets/images/logos/logo-02.png" alt="logo"></span>
        </div>
        <!-- Material Design Spinner -->
        <div class="spinner-wrapper">
            <div class="spinner">
                <div class="inner">
                    <div class="gap"></div>
                    <div class="left">
                        <div class="half-circle"></div>
                    </div>
                    <div class="right">
                        <div class="half-circle"></div>
                    </div>
                </div>
            </div>
        </div>
        <!-- / Material Design Spinner -->
    </div>
</ms-splash-screen>
<!-- / SPLASH SCREEN -->


<div id="main" class="block-ui-main animate-slide-up" ui-view="main" layout="column">
    @RenderBody()
</div>
<ms-theme-options></ms-theme-options>
    @*@Scripts.Render("~/BowerComponents/jquery")*@
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
    @*@Scripts.Render("~/BowerComponents/angularjs")*@
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.5.8/angular.min.js"></script>
    @*@Scripts.Render("~/BowerComponents/angularAnimate")*@
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.5.8/angular-animate.min.js"></script>
    @*@Scripts.Render("~/BowerComponents/angularAria")*@
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.5.8/angular-aria.min.js"></script>
    @*@Scripts.Render("~/BowerComponents/angularCookies")*@
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.5.8/angular-cookies.min.js"></script>
    @*@Scripts.Render("~/BowerComponents/angularSanitize")*@
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.5.8/angular-sanitize.min.js"></script>
    @*@Scripts.Render("~/BowerComponents/angularResource")*@
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.5.8/angular-resource.min.js"></script>
    @Scripts.Render("~/Scripts/bower")    
    <script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCAl-t_5yPp7NyYLwNjO8Ypzw1AU3RdrkQ&libraries=geometry,places"></script>
    @Scripts.Render("~/Scripts/js")
    @Scripts.Render("~/Scripts/quick")
    @Scripts.Render("~/Scripts/core")
    @Scripts.Render("~/Scripts/controller")    
    <script src="~/Scripts/jquery.signalR-2.2.1.min.js"></script>
</body>
</html>